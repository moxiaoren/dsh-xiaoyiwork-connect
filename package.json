{
  "name": "dsh-xiaoyiwork-connect",
  "version": "0.2.0",
  "displayName": "小艺Work 模型代理",
  "description": "DeepSeek Harness 插件（Windows 专用）：复用已登录的小艺Work 桌面端模型代理额度，无需单独 API Key。",
  "author": "moxiaoren",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "xiaoyiwork",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxiaoren/dsh-xiaoyiwork-connect.git"
  },
  "homepage": "https://github.com/moxiaoren/dsh-xiaoyiwork-connect#readme",
  "bugs": {
    "url": "https://github.com/moxiaoren/dsh-xiaoyiwork-connect/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.2",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.7.5"
  }
}
